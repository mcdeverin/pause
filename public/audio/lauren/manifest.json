    {
      "clip_id": "clip_050",
      "text": "Take a gentle breath in, pause briefly, and let it out slowly.",
      "used_by": [
        {
          "technique": "6-2-7 Breathing",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_051",
      "text": "Take your time breathing out, without pushing out every last bit of air.",
      "used_by": [
        {
          "technique": "Extended Exhale",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_052",
      "text": "This is a long-hold practice. Keep it easy and skip the hold if it feels uncomfortable.",
      "used_by": [
        {
          "technique": "1-4-2 Ratio Breathing",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_053",
      "text": "This is an advanced alternate-nostril practice. Follow the nostril instructions you have learned, and never force a hold.",
      "used_by": [
        {
          "technique": "Nadi Shodhana Advanced",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_054",
      "text": "This practice includes a pause after exhaling. Never push through air hunger.",
      "used_by": [
        {
          "technique": "Buteyko Breathing",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_055",
      "text": "Three equal phases: inhale, hold, and exhale.",
      "used_by": [
        {
          "technique": "Triangle Breathing",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_056",
      "text": "Use a gentle hand position to alternate nostrils. Avoid forcing any holds.",
      "used_by": [
        {
          "technique": "Alternate Nostril Breathing",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_057",
      "text": "We will breathe in for four, hold for seven, and exhale for eight. Keep it comfortable.",
      "used_by": [
        {
          "technique": "4-7-8 Breathing",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_058",
      "text": "We will breathe in, pause briefly, then lengthen the exhale.",
      "used_by": [
        {
          "technique": "478 Variation",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_059",
      "text": "We will fill the breath in three stages: belly, chest, and upper chest.",
      "used_by": [
        {
          "technique": "3-Part Yogic Breath",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_060",
      "text": "We will make room for a gentle inhale and a longer release.",
      "used_by": [
        {
          "technique": "Anti-Anxiety Breath",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_061",
      "text": "We will move through four equal parts, keeping the breath controlled and relaxed.",
      "used_by": [
        {
          "technique": "Combat Tactical Breathing",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_062",
      "text": "We will move through three even parts: breathe in, pause, and breathe out.",
      "used_by": [
        {
          "technique": "4-4-4 Triangle",
          "position": "intro"
        }
      ]
    },
    {
      "clip_id": "clip_063",
      "text": "Welcome to a short, steady rhythm to begin your day.",
      "used_by": [
        {
          "technique": "Morning Activation Breath",
          "position": "intro"
        }
      ]
    },
    {
